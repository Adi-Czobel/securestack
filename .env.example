# Copy to .env before starting the stack:
#   cp .env.example .env
#
# These are local development placeholders. Generate a real password before
# running this anywhere that is not your own machine:
#   openssl rand -base64 24

# --- Postgres container bootstrap (consumed by the postgres:16-alpine image) ---
POSTGRES_DB=tasksdb
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me-local-only

# --- Flask app database client (app/app.py) ---
# Keep these in sync with the POSTGRES_* values above; they describe the same
# database from the client side.
DB_NAME=tasksdb
DB_USER=taskuser
DB_PASSWORD=change-me-local-only
